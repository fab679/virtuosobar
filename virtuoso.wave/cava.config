# Virtuoso Wave cava config: 12 ASCII bars to stdout for the bar widget.
[general]
framerate = 20
bars = 12

[input]
method = pipewire
source = auto

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
bar_delimiter = 59
frame_delimiter = 10

[smoothing]
monstercat = 1
